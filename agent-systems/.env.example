# Runtime environment: development | test | production
NODE_ENV=development

# Required to run the examples and capstone with a live model.
# Tests do NOT need this — they use a mocked language model.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the default model used by examples and the capstone.
AGENT_SYSTEMS_MODEL=gpt-4o-mini

# Optional: run examples/capstone offline with a deterministic mock model.
# Forbidden when NODE_ENV=production.
AGENT_SYSTEMS_MOCK=0
