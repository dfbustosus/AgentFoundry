{
  "name": "agent-systems-foundry",
  "version": "0.3.0-rc.1",
  "description": "Reference architecture for agentic systems in TypeScript: PRAO loops, tool contracts, decomposition, orchestration, handoffs, memory, reliability, and enforcement — built on Vercel AI SDK Core.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "David BU <dfbustos@uninorte.edu.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfbustosus/AgentFoundry.git",
    "directory": "agent-systems"
  },
  "keywords": [
    "agents",
    "llm",
    "ai-sdk",
    "orchestration",
    "reliability",
    "agentic-workflows",
    "mcp",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "api:check": "npm run build && api-extractor run",
    "api:update": "npm run build && api-extractor run --local",
    "package:lint": "npm run build && publint --strict --pack=false && attw --pack . --profile esm-only --no-emoji --no-color",
    "package:consumer": "node scripts/verify-package.mjs",
    "package:verify": "npm run api:check && npm run package:lint && npm run package:consumer",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx",
    "capstone": "tsx capstone/src/run.ts",
    "capstone:eval": "tsx capstone/evals/run-evals.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.20",
    "@ai-sdk/openai": "4.0.25",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "7.0.43",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.4",
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.6",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "24.13.3",
    "publint": "0.3.23",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
